{
  "name": "lab4_test",
  "version": "1.0.0",
  "description": "JWT Authentication API deployed on GitHub Runner",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:watch": "NODE_ENV=test jest --watch --detectOpenHandles",
    "start:test": "NODE_ENV=test PORT=8080 DB_STORAGE=./test.sqlite node server.js",
    "start:production": "NODE_ENV=production PORT=3000 DB_STORAGE=./production.sqlite node server.js",
    "test:unit": "NODE_ENV=test jest --coverage --testPathIgnorePatterns=tests/integration --detectOpenHandles --forceExit",
    "test": "npm run test:unit && npm run test:integration",
    "test:integration": "NODE_ENV=test jest tests/integration --verbose --detectOpenHandles --forceExit --passWithNoTests",
    "test:integration:basic": "NODE_ENV=test jest tests/integration/basic.test.js --verbose",
    "test:integration:auth": "NODE_ENV=test jest tests/integration/auth.routes.test.js --verbose",
    "test:integration:user": "NODE_ENV=test jest tests/integration/user.routes.test.js --verbose",
    "check:prod": "docker-compose -f docker-compose.prod.yml -p jwt-auth-prod ps",
    "docker:clean": "./cleanup.sh"
  },
  "keywords": [
    "authentication",
    "jwt",
    "session",
    "express",
    "postgres",
    "github-actions"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "apollo-server": "^3.13.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dataloader": "^2.2.3",
    "express": "^4.18.2",
    "graphql": "^16.12.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.32.1",
    "sqlite3": "^5.1.7",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
